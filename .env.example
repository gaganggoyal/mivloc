# ── Supabase API (required)
# Self-hosted on the VPS (default): the URL is the site + /api, and the anon
# key is printed by supabase/setup.sh (or: grep ANON_KEY supabase/.env on the server).
# Hosted supabase.com project: use its Project URL + anon key instead.
NEXT_PUBLIC_SUPABASE_URL=https://mivloc.online/api
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# ── Site URL (required for email verification redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
