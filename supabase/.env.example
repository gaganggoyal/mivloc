# Mivloc self-hosted Supabase — server-side config.
# ./setup.sh creates the real .env with generated secrets (never commit it).

# ── Generated by setup.sh ────────────────────────────────────
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=            # public — goes into frontend NEXT_PUBLIC_SUPABASE_ANON_KEY
SERVICE_ROLE_KEY=    # admin key: bypasses RLS. Server-side use only, never in the app
SECRET_KEY_BASE=     # Realtime, 64+ chars
REALTIME_DB_ENC_KEY= # Realtime, exactly 16 chars

# ── URLs ─────────────────────────────────────────────────────
SITE_URL=https://mivloc.online
PUBLIC_API_URL=https://mivloc.online/api   # where Caddy exposes Kong
PUBLIC_API_PATH=/api                       # path part of PUBLIC_API_URL
ADDITIONAL_REDIRECT_URLS=https://mivloc.online/**,http://localhost:3000/**
JWT_EXPIRY=3600
EDGE_NETWORK=cricketverse_deploy_default   # docker network Caddy lives on

# ── Email (signup verification) ──────────────────────────────
# Any SMTP provider works (Resend, Brevo, SES, Gmail app password…).
# Leave blank = signups fail with "could not send verification email".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=no-reply@mivloc.online
SMTP_SENDER_NAME=Mivloc
# Emergency switch: true = accounts activate without any email
ENABLE_EMAIL_AUTOCONFIRM=false
# Keep true until SMTP_* are filled in — with no mailer GoTrue would silently
# create accounts that can never be verified.
DISABLE_SIGNUP=true
